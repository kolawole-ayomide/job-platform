# Server
PORT=5000
NODE_ENV=development
DB_NAME=

# MongoDB Atlas connection string
DATABASE_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/job-platform

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS + cookie settings)
CLIENT_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (email verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Wizpace <no-reply@wizpace.com>

# Anthropic (AI assistant)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Wizbot automation scheduler (optional - defaults to 2 minutes)
WIZBOT_SCAN_INTERVAL_MS=120000

#jsearch
JSEARCH_API_KEY=your_jsearch_api_key

# Social login - Google (Google Identity Services, verified via tokeninfo)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Social login - LinkedIn (OpenID Connect - create an app at https://www.linkedin.com/developers/apps
# and request the "Sign In with LinkedIn using OpenID Connect" product)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/linkedin/callback

# Social login - GitHub (create an OAuth App at
# https://github.com/settings/developers -> "New OAuth App". Set its
# "Authorization callback URL" to exactly match GITHUB_REDIRECT_URI below.)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/auth/github/callback

# NOTE: there is intentionally no CRUNCHBASE_*/GREENHOUSE_* config. Neither
# offers a public "Sign in with X" OAuth provider for third-party apps to
# authenticate job seekers with - both only support the reverse direction
# (their own staff/recruiters logging in), or require a formal, manually-
# approved business partnership rather than self-serve API keys. Replaced
# with real GitHub sign-in instead - see README if you want the history.

# Real external job listings - JSearch API (via RapidAPI or OpenWebNinja).
# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free
# tier), subscribe, then copy the X-RapidAPI-Key from the Endpoints/Playground
# tab. Without this set, job syncing just logs an error and no-ops - the app
# still runs, "Discover Jobs" just stays empty until it's configured.
JSEARCH_API_KEY=your_rapidapi_jsearch_key
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Optional: how often (ms) the broad job-sync rotation runs. Defaults to
# 6 hours. Lower this only if your JSearch plan has quota to spare - every
# tick is a real billed/metered API call.
JOB_SYNC_INTERVAL_MS=21600000